---
// Kohlensäure: Bläschen steigen in fünf Strömen auf, vorne groß und schnell, hinten klein und langsam
const streams = [8, 27, 48, 70, 90];
const bubbles = streams.flatMap((sx, s) => Array.from({ length: 9 }, (_, k) => {
  const i = s * 9 + k;
  const r = n => (Math.sin(i * 91.7 + n * 17.3) + 1) / 2;
  const near = i % 3 === 0;
  const d = near ? 9 + r(1) * 6 : 16 + r(1) * 10;
  return {
    x: (sx + (r(2) - 0.5) * 2.6).toFixed(1),
    s: near ? Math.round(10 + r(3) * 12) : Math.round(4 + r(3) * 6),
    d: d.toFixed(1),
    dl: (-r(4) * d).toFixed(1),
    sw: near ? Math.round(6 + r(5) * 10) : Math.round(3 + r(5) * 5),
    sd: (2.2 + r(6) * 2.5).toFixed(1),
    o: near ? 0.9 : 0.5
  };
}));
---
<div class="bg" aria-hidden="true"><div class="l1"></div><div class="l2"></div></div>
<div class="rise" aria-hidden="true">
  {bubbles.map(b => (
    <span class="b" style={`--x:${b.x}%;--d:${b.d}s;--dl:${b.dl}s`}><i style={`--s:${b.s}px;--sw:${b.sw}px;--sd:${b.sd}s;--dl:${b.dl}s;--o:${b.o}`}></i></span>
  ))}
</div>
<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const L = [['.l1', 0.06], ['.l2', 0.14]].map(([s, k]) => [document.querySelector('.bg ' + s), k]);
    let t = false;
    const f = () => { const y = scrollY; L.forEach(([e, k]) => { e.style.transform = `translate3d(0,${-y * k}px,0)`; }); t = false; };
    addEventListener('scroll', () => { if (!t) { t = true; requestAnimationFrame(f); } }, { passive: true });
    f();
  }
</script>
