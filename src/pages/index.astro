---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import data from '../data/brauhaeuser.json';
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Thekenschaaf – Brauhaus-Tour in Köln planen</title>
  <meta name="description" content="Plane deine Brauhaus-Tour durch Köln: Brauhäuser auf der Karte auswählen, Reihenfolge festlegen und die Route mit aufs Handy nehmen.">
</head>
<body>
  <div id="gate" role="dialog" aria-modal="true" aria-labelledby="gt">
    <div>
      <h2 id="gt">Bist du schon 18?</h2>
      <p id="gp">Diese Seite dreht sich um Bier. Bitte bestätige dein Alter, bevor du weitermachst.</p>
      <div class="row" id="gb"><button class="pri" id="yes">Ja, ich bin 18 oder älter</button><button id="no">Nein</button></div>
    </div>
  </div>

  <main class="wrap">
    <h1>Thekenschaaf</h1>
    <p class="lead">Such dir Brauhäuser aus, sortier die Reihenfolge und nimm die Route mit aufs Handy. Wer zuerst plant, trinkt später entspannter.</p>
    <div class="filters" role="group" aria-label="Filter">
      <button data-f="all" class="on">Alle</button>
      <button data-f="b">Brauhäuser</button>
      <button data-f="k">Kölsch-Kneipen</button>
    </div>
    <div class="grid">
      <div id="map" aria-label="Karte der Brauhäuser"></div>
      <div class="panel">
        <section class="tour" aria-live="polite">
          <h2>Deine Tour</h2>
          <p class="empty" id="empty">Tippe auf ein Glas auf der Karte oder auf „Zur Tour hinzufügen“.</p>
          <ol id="tl"></ol>
          <div class="row">
            <a class="btn pri" id="go" target="_blank" rel="noopener" aria-disabled="true">Route in Google Maps</a>
            <button id="cheers">Anstoßen</button>
            <button id="clear">Tour leeren</button>
          </div>
        </section>
        <h2>Brauhäuser</h2>
        <div class="all">
          {data.map(h => (
            <details class="item" data-id={h.id} data-kat={h.kat}>
              <summary><b>{h.name}</b>{h.marke && <em>{h.marke}</em>}</summary>
              <p>{h.info}</p>
              <p class="meta">{h.adresse}, Köln<br>{h.zeiten ?? 'Öffnungszeiten werden noch geprüft.'}</p>
              {h.web && <a href={h.web} rel="noopener" target="_blank">Website</a>}
              <button class="add" data-add={h.id}>Zur Tour hinzufügen</button>
            </details>
          ))}
        </div>
        <footer>
          <p>Bitte trinke verantwortungsvoll. Infos und Öffnungszeiten ohne Gewähr.</p>
          <p><a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></p>
        </footer>
      </div>
    </div>
  </main>

  <div class="bar"><span id="cnt">0 Stopps</span><a class="btn pri" id="go2" target="_blank" rel="noopener" aria-disabled="true">Route in Google Maps</a></div>

  <script id="data" type="application/json" is:inline set:html={JSON.stringify(data)}></script>
  <script>import '../scripts/app.js';</script>
</body>
</html>
